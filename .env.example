# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Base URL of the results platform
NAJAH_BASE_URL=https://najah.iq

# Request timeout in milliseconds
NAJAH_TIMEOUT_MS=30000

# The login form is protected by an ALTCHA proof-of-work anti-bot check.
# Automating it is only allowed with written authorization from the
# Ministry of Education. Set this to "true" ONLY if you have that
# authorization. With it unset the bot refuses to query the site.
NAJAH_AUTOMATION_AUTHORIZED=false

# Max lookups allowed per user per hour
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=3600000
